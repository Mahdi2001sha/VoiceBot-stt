# URL of the WhisperLiveKit REST endpoint (the "wlk" process, started by start.bat).
WHISPER_API_URL=http://127.0.0.1:8000/v1/audio/transcriptions

# Base URL used to derive /health etc. (same host:port, no path)
WHISPER_BASE_URL=http://127.0.0.1:8000

# wlk's native WebSocket for live/streaming transcription
WHISPER_WS_URL=ws://127.0.0.1:8000/asr

# Informational only - shown in GET /api/health. Change WLK's own --model
# flag in start.bat to actually switch models; this doesn't do that itself.
DEFAULT_MODEL=large-v3

# Default transcription language (fa = Farsi/Persian). "auto" also works if wlk supports it.
DEFAULT_LANGUAGE=fa

# How many transcription jobs may run at the SAME TIME inside the whisper engine.
# Keep this LOW (1-2) on CPU. Raise it only if you run wlk on a GPU box.
# Does NOT limit how many clients can connect/upload/record at once (see run.py).
MAX_CONCURRENT_TRANSCRIPTIONS=2

# Reject uploads larger than this (megabytes)
MAX_UPLOAD_MB=50

# How long (seconds) our backend waits for wlk to finish transcribing one
# file. Keep this AT OR ABOVE the --rest-timeout value wlk is started with
# (see start.bat), or you'll get a confusing error on our side instead of
# a clean one from wlk.
TRANSCRIBE_TIMEOUT_SECONDS=1800

# Host/port this backend listens on
HOST=0.0.0.0
PORT=8080
